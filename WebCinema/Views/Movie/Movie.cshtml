@model IEnumerable<WebCinema.Models.Movie>
@{
    ViewData["Title"] = "Phim";
    Layout = "~/Views/Shared/_LayoutHeader2.cshtml";

    // Lọc phim đang chiếu
    var phimDangChieu = Model.Where(movie => movie.MovieState.Contains("Đang Chiếu")).ToList();

    // Lọc phim sắp chiếu
    var phimSapChieu = Model.Where(movie => movie.MovieState.Contains("Sắp Chiếu")).ToList();
}
<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/css/movie.css" rel="stylesheet" />
<link href="~/css/font-awesome.min.css" rel="stylesheet" />
<script src="~/js/movie.js"></script>
<link rel="stylesheet" href="~/css/Movie.css">

<body>
    <div class="Title-span shar" style="font-weight: bold; padding-top: 170px;">
        <a href="/">
            <span>Trang Chủ</span>
        </a>
        >
        <label>
            <span id="Phim.cshtml">Phim</span>
            <span id="sublink"></span>
        </label>
    </div>

    <div class="Wrapper-main">
        <div id="btalk-contents">
            <!-- Nút chọn chi nhánh -->
            <div class="text-center mb-4">
                <button class="btn btn-primary" onclick="filterMoviesByBranch('Hồ Chí Minh')">Hồ Chí Minh</button>
                <button class="btn btn-primary" onclick="filterMoviesByBranch('Hà Nội')">Hà Nội</button>
                <button class="btn btn-primary" onclick="filterMoviesByBranch('Đà Nẵng')">Đà Nẵng</button>
                <button class="btn btn-secondary" onclick="filterMoviesByBranch('Tất cả')">Tất cả</button> <!-- Nút để hiển thị tất cả phim -->
            </div>

            <div class="tab-movie">
                <ul class="tab-movie-item nav nav-tabs justify-content-center" style="width:auto">
                    @if (phimDangChieu != null)
                    {
                        <li class="active li-pdc">
                            <a class="movie-custom-tab" data-toggle="tab" href="#movie-dc-all" aria-expanded="true">
                                <span class="span-tab-all">Phim Đang Chiếu</span>
                            </a>
                        </li>
                    }
                    @if (phimSapChieu != null)
                    {
                        <li class="active">
                            <a class="movie-custom-tab li-psc" data-toggle="tab" href="#movie-sc-all" aria-expanded="false">
                                <span class="span-tab-all">Phim Sắp Chiếu</span>
                            </a>
                        </li>
                    }
                </ul>
                <!-- Tab Contents Movies -->
                <div class="tab-content tab-content-custom">
                    <!-- Phim Đang Chiếu -->
                    <div id="movie-dc-all" class="tab-pane fade active in" style="min-height: 218px">
                        <div class="movie-hot clearfix" id="movie-list">
                            @foreach (var movie in Model.Where(m => m.MovieState.Contains("1")))
                            {
                                <div class="list-items movie-item" data-branch="@movie.BranchId">
                                    <div class="item-left">
                                        <a href="/MovieDetails/MovieDetails/?movieId=@movie.MovieId">
                                            <div class="episode-all">
                                                @if (!string.IsNullOrEmpty(movie.Poster))
                                                {
                                                    var imagePath = Url.Content(movie.Poster); // Use Url.Content
                                                    <img src="@imagePath" alt="Movie Poster" />
                                                }
                                            </div>
                                        </a>
                                    </div>

                                    <div class="item-right">
                                        <a href="/MovieDetails/MovieDetails/?movieId=@movie.MovieId">
                                            <h4 class="movie-color">@movie.MovieName</h4>
                                        </a>
                                        <p class="icon-clock">Thời lượng: <span>@movie.MovieLength</span></p>
                                        <p class="icon-type">Thể Loại: <span>@movie.Genre.GenreName</span></p>
                                        <p class="icon-calendar">Khởi Chiếu: <span>@movie.ReleaseDate.ToShortDateString()</span></p>
                                        <a class="active">
                                            <span class="ganre">2D</span>
                                            <span class="viet_sub">Phụ đề / sub</span>
                                        </a>
                                        <div class="movie-tool">
                                            <div class="imdb">
                                                <div data-imdb-id="1133" class="score" imdb=""></div>
                                                <span>IMDB</span>
                                            </div>
                                            <div class="trailer">
                                                <a class="open-popup-youtube" href="#">
                                                    <div class="trailer-button" data-trailer="@movie.Trailer">
                                                        <i class="fa fa-play"></i>
                                                        <span>Watch Trailer</span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Phim Sắp Chiếu -->
                    <div id="movie-sc-all" class="tab-pane fade" style="min-height: 218px">
                        <div class="movie-hot clearfix">
                            @foreach (var movie in Model.Where(m => m.MovieState.Contains("2")))
                            {
                                <div class="list-items movie-item" data-branch="@movie.BranchId">
                                    <div class="item-left">
                                        <a href="/MovieDetails/MovieDetails/?movieId=@movie.MovieId">
                                            <div class="episode-all">
                                                @if (!string.IsNullOrEmpty(movie.Poster))
                                                {
                                                    var imagePath = Url.Content(movie.Poster); // Use Url.Content
                                                    <img src="@imagePath" alt="Movie Poster" />
                                                }
                                            </div>
                                        </a>
                                    </div>

                                    <div class="item-right">
                                        <a href="/MovieDetails/MovieDetails/?movieId=@movie.MovieId">
                                            <h4 class="movie-color">@movie.MovieName</h4>
                                        </a>
                                        <p class="icon-clock">Thời lượng: <span>@movie.MovieLength</span></p>
                                        <p class="icon-type">Thể Loại: <span>@movie.Genre.GenreName</span></p>
                                        <p class="icon-calendar">Khởi Chiếu: <span>@movie.ReleaseDate.ToShortDateString()</span></p>
                                        <a class="active">
                                            <span class="ganre">2D</span>
                                            <span class="viet_sub">Phụ đề / sub</span>
                                        </a>
                                        <div class="movie-tool">
                                            <div class="imdb">
                                                <div data-imdb-id="1133" class="score" imdb=""></div>
                                                <span>IMDB</span>
                                            </div>
                                            <div class="trailer">
                                                <a class="open-popup-youtube" href="#">
                                                    <div class="trailer-button" data-trailer="@movie.Trailer">
                                                        <i class="fa fa-play"></i>
                                                        <span>Watch Trailer</span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.onload = function () {
            var tabPDC = document.querySelector('.li-pdc a');
            tabPDC.click(); // Kích hoạt sự kiện click trên tab "Phim Đang Chiếu"
        };

        function filterMoviesByBranch(branchId) {
            // Ẩn tất cả các phim
            var allMovies = document.querySelectorAll('.movie-item');
            allMovies.forEach(function(movie) {
                movie.style.display = 'none'; // Ẩn tất cả
            });

            if (branchId === 'Tất cả') {
                // Hiển thị tất cả phim nếu chọn "Tất cả"
                allMovies.forEach(function(movie) {
                    movie.style.display = 'block'; // Hiển thị tất cả
                });
            } else {
                // Hiển thị phim theo chi nhánh đã chọn
                var filteredMovies = document.querySelectorAll('.movie-item[data-branch="' + branchId + '"]');
                filteredMovies.forEach(function(movie) {
                    movie.style.display = 'block'; // Hiển thị phim theo chi nhánh
                });
            }
        }
    </script>
</body>

<div id="trailerModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <iframe id="trailerIframe" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    </div>
</div>

<script src="~/assets/js/bootstrap.min.js"></script>