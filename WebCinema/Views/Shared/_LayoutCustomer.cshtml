<body>
    <div id="particles-js"></div>
    <div id="home">
        <div class="site-header">
            <div class="top-header">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6 col-sm-6">
                            <div class="left-header">
                                <span><i class="fa fa-phone"></i>080 080 0990</span>
                                <span><i class="fa fa-envelope"></i>abc@gmail.com</span>
                            </div> <!-- /.left-header -->
                        </div> <!-- /.col-md-6 -->
                        <div class="col-md-6 col-sm-6">
                            <div class="right-header text-right">
                                <ul class="social-icons">
                                    <li><a href="https://facebook.com/itHutech" class="fa fa-facebook"></a></li>
                                    <li><a href="https://youtube.com/user/galaxymovies" class="fa fa-youtube"></a></li>
                                    <li><a href="https://www.instagram.com/galaxycinema" class="fa fa-instagram"></a>
                                    </li>
                                </ul>
                            </div> <!-- /.left-header -->
                        </div> <!-- /.col-md-6 -->
                    </div> <!-- /.row -->
                </div> <!-- /.container -->
            </div> <!-- /.top-header -->
