@model IEnumerable<WebCinema.Models.Movie>
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}<style>
    .custom-button {
        width: 100%;
        /* Chiều rộng đầy đủ */
        height: 20rem;
        /* Chiều cao cố định */
        display: flex;
        /* Sử dụng Flexbox */
        align-items: center;
        /* Căn giữa theo trục dọc */
        justify-content: center;
        /* Căn giữa theo trục ngang */
        text-decoration: none;
        /* Bỏ gạch chân */
        color: black;
        /* Màu chữ mặc định */
        background-color: transparent;
        /* Không có màu nền ban đầu */
        border: 1px solid black;
        /* Đường viền tùy chọn */
        border-radius: 5px;
        /* Bo góc cho nút */
        font-size: 24px;
        /* Phông chữ lớn hơn */
        font-weight: bold;
        /* Chữ đậm */
        transition: all 0.3s ease;
        /* Hiệu ứng chuyển đổi mượt */
        background-image: url("images/poster.jpg");
        /* Hình nền */
        background-size: cover;
        /* Phủ kín khung */
        background-position: center;
        /* Hiển thị trung tâm hình ảnh */
        color: white;
        /* Màu chữ trên nền ảnh */
        text-shadow: 1px 1px 3px black;
        /* Tạo bóng cho chữ */
    }

    .custom-button:hover {
        color: white;
        /* Đổi màu chữ thành trắng */
        transform: scale(1.05);
        /* Phóng to nhẹ khi hover */
    }

    .custom-button1 {
        width: 100%;
        /* Chiều rộng đầy đủ */
        height: 20rem;
        /* Chiều cao cố định */
