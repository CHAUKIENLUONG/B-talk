        /* Căn giữa theo trục ngang */
        text-decoration: none;
        /* Bỏ gạch chân */
        color: black;
        /* Màu chữ mặc định */
        background-color: transparent;
        /* Không có màu nền ban đầu */
        border: 1px solid black;
        /* Đường viền tùy chọn */
        border-radius: 5px;
        /* Bo góc cho nút */
        font-size: 24px;
        /* Phông chữ lớn hơn */
        font-weight: bold;
        /* Chữ đậm */
        transition: all 0.3s ease;
        /* Hiệu ��ng chuyển đổi mượt */
        background-image: url("images/poster1.png");
        /* Hình nền */
        background-size: cover;
        /* Phủ kín khung */
        background-position: center;
        /* Hiển thị trung tâm hình ảnh */
        color: white;
        /* Màu chữ trên nền ảnh */
        text-shadow: 1px 1px 3px black;
        /* Tạo bóng cho chữ */
    }

    .custom-button1:hover {
        color: white;
        /* Đổi màu chữ thành trắng */
        transform: scale(1.05);
        /* Phóng to nhẹ khi hover */
    }

    .portfolio-thumb {
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .portfolio-thumb img {
        width: 100%;
        height: auto;
        transition: transform 0.3s ease;
    }

    .portfolio-thumb:hover img {
        transform: scale(1.1);
    }

    .overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.7);
        padding: 20px;
        transform: translateY(100%);
        transition: transform 0.3s ease;
    }

    .portfolio-thumb:hover .overlay {
        transform: translateY(0);
    }

    .badge {
        padding: 5px 10px;
        border-radius: 3px;
        font-size: 14px;
        margin-bottom: 10px;
        display: inline-block;
    }

    .bg-warning {
        background-color: #ffd700 !important;
    }

    .bg-secondary {
        background-color: #c0c0c0 !important;
    }

    .bg-bronze {
        background-color: #cd7f32 !important;
    }
</style>

<div class="flexslider">
    <ul class="slides">
        @foreach (var movie in Model)
        {
            <li>
                <img src="@Url.Content(@movie.Poster)" alt="@movie.MovieName">
                <div class="flex-caption">
                    <h2>@movie.MovieName</h2>
                    <span></span>
                    <p>@movie.Description</p>
                    <a href="/MovieDetails/MovieDetails/?movieId=@movie.MovieId" class="detail-link btn btn-danger">
                        Chi Tiết <i class="fa fa-angle-right"></i>
                    </a>
                </div>
            </li>
        }
    </ul>
</div>





<div id="services" class="section-cotent">
    <div class="container">
        <div class="title-section text-center">
            <h2 style="color:aliceblue">Phim/Lịch Chiếu</h2>
            <span></span>
        </div> <!-- /.title-section -->
        <div class="row">

            <div class="col-md-6 col-sm-6">
                <div class="service-item">
                    <div class="service-header">
                        <i class="fa fa-desktop"></i>
                        <h3>Phim</h3>
                    </div>
                    <a href="/Movie/Movie/" class="service-description custom-button ">
                        <span> Xem Phim</span>
                    </a>
                </div> <!-- /.service-item -->
            </div> <!-- /.col-md-3 -->

            <div class="col-md-6 col-sm-6">
                <div class="service-item">
                    <div class="service-header">
                        <i class="fa fa-heart"></i>
                        <h3>Lịch chiếu</h3>
                    </div>
                    <a href="ShowTimes/ShowTimes/" class="service-description custom-button1">
                        <span> Xem Lịch Chiếu</span>
                    </a>
                </div> <!-- /.service-item -->
            </div> <!-- /.col-md-3 -->
        </div> <!-- /.row -->
    </div> <!-- /.container -->
</div> <!-- /#services -->

<div id="portfolio" class="section-content">
    <div class="container">
        <div class="title-section text-center">
            <h2 style="color:aliceblue">Top Phim Bán Chạy Nhất</h2>
            <span></span>
        </div>
        <div class="row">
            @{var index = 0;}
            @foreach (var item in ViewBag.TopMovies)
            {
                <div class="col-md-4">
                    <div class="portfolio-thumb">
                        <img src="@Url.Content(item.Movie.Poster)" alt="Top @(index + 1)">
                        <div class="overlay">
                            <div class="inner">
                                <h4>
                                    <a href="/MovieDetails/MovieDetails/?movieId=@item.Movie.MovieId">
                                        @item.Movie.MovieName
                                    </a>
                                </h4>
                                <span class="badge @(index == 0 ? "bg-warning text-dark" : 
                                                   index == 1 ? "bg-secondary text-light" : 
                                                   "bg-bronze text-light")">
                                    Top @(index + 1)
                                </span>
                                <p>Số vé đã bán: @item.TicketCount</p>
                            </div>
                        </div>
                    </div>
                </div>
                index++;
            }
        </div>
    </div>
</div>

