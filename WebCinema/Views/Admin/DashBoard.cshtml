<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Lấy dữ liệu từ ViewBag
        var chartData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartData));

        // Cấu hình biểu đồ
        var options = {
            chart: {
                type: 'bar',
                height: 350
            },
            series: [{
                name: 'Tickets Sold',
                data: chartData.map(d => d.Count) // Lấy số lượng vé
            }],
            xaxis: {
                categories: chartData.map(d => d.Date), // Lấy ngày
                title: {
                    text: "Date"
                }
            },
            yaxis: {
                title: {
                    text: "Tickets Sold"
                }
            },
            title: {
                text: "Tickets Sold by Day",
                align: 'center'
            }
        };

        // Khởi tạo biểu đồ
        var chart = new ApexCharts(document.querySelector("#chart"), options);
        chart.render();
    });
</script>

