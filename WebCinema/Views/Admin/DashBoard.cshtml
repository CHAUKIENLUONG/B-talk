        </div>
        <div class="row">
            <div class="col-lg-4 d-flex align-items-stretch">
                <div class="card w-100">
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <h5 class="card-title fw-semibold">Danh sách vé đặt</h5>
                        </div>
                        <!-- Danh sách vé -->
                        <ul class="timeline-widget mb-0 position-relative mb-n5">
                            @foreach (var ticket in Model)
                            {
                                <li class="timeline-item d-flex position-relative overflow-hidden">
                                    <div class="timeline-time text-dark flex-shrink-0 text-end">@ticket.PurchaseDate</div>
                                    <div class="timeline-badge-wrap d-flex flex-column align-items-center">
                                        <span class="timeline-badge border-2 border border-primary flex-shrink-0 my-8"></span>
                                    </div>
                                    <div class="timeline-desc fs-3 text-dark mt-n1">
                                        Thanh toán từ @ticket.Email với số tiền @ticket.Total
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="card w-100">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table text-nowrap mb-0 align-middle">
                                <div class="row mb-4">
                                    <!-- Vé theo ngày -->
                                    <div class="col-4">
                                        <h4 class="fw-semibold mb-3">Vé theo ngày</h4>
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Ngày</th>
                                                    <th>Số lượng vé</th>
                                                    <th>Tổng doanh thu</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var day in ViewBag.TicketsByDay)
                                                {
                                                    <tr>
                                                        <td>@day.Date.ToString("dd/MM/yyyy")</td>
                                                        <td>@day.Count</td>
                                                        <td>@day.TotalRevenue</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Vé theo tháng -->
                                    <div class="col-4">
                                        <h4 class="fw-semibold mb-3">Vé theo tháng</h4>
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Năm</th>
                                                    <th>Tháng</th>
                                                    <th>Số lượng vé</th>
                                                    <th>Tổng doanh thu</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var month in ViewBag.TicketsByMonth)
                                                {
                                                    <tr>
                                                        <td>@month.Year</td>
                                                        <td>@month.Month</td>
                                                        <td>@month.Count</td>
                                                        <td>@month.TotalRevenue</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Vé theo năm -->
                                    <div class="col-4">
                                        <h4 class="fw-semibold mb-3">Vé theo năm</h4>
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Năm</th>
                                                    <th>Số lượng vé</th>
                                                    <th>Tổng doanh thu</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var year in ViewBag.TicketsByYear)
                                                {
                                                    <tr>
                                                        <td>@year.Year</td>
                                                        <td>@year.Count</td>
                                                        <td>@year.TotalRevenue</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<script src="~/Admin/libs/jquery/dist/jquery.min.js"></script>
