<script>
    document.addEventListener("DOMContentLoaded", function () {
        const releaseDateInput = document.querySelector("input[name='ReleaseDate']");
        const movieStateInput = document.querySelector("input[name='MovieState']");

        releaseDateInput.addEventListener("change", function () {
            const selectedDate = new Date(this.value);
            const today = new Date();
            today.setHours(0, 0, 0, 0); // Đặt giờ về 0 để so sánh chính xác

            if (selectedDate.getTime() === today.getTime()) {
                movieStateInput.value = "1"; // Đang Chiếu
            } else if (selectedDate > today) {
                movieStateInput.value = "2"; // Sắp Chiếu
            } else {
                movieStateInput.value = ""; // Không có trạng thái
            }
        });
    });
</script>


<script>
    document.querySelector('form').addEventListener('submit', function (event) {
        var trailerInput = document.querySelector('textarea[name="Trailer"]');
        var trailerURL = trailerInput.value;

        if (trailerURL.startsWith("https://www.youtube.com/watch?v=")) {
            let videoId = trailerURL.split("v=")[1];
            trailerURL = "https://www.youtube.com/embed/" + videoId;
        } else if (!trailerURL.startsWith("https://www.youtube.com/embed/")) {
            trailerURL = "https://www.youtube.com/embed/" + trailerURL;
        }

        trailerInput.value = trailerURL;
    });

</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById("EndDate").setAttribute('min', today);
    });
</script>
