@model WebCinema.ViewModels.AddShowtimeViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Add ShowTime";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var selectedMovie = ViewBag.SelectedMovie as WebCinema.Models.Movie;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="body-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-8 d-flex align-items-strech">
                <div class="card w-100">
                    <div class="card-body">
                        <div class="d-sm-flex d-block align-items-center justify-content-between mb-9">
                            <div class="mb-3 mb-sm-0">
                                <div class="text-center mb-4">
                                    <form asp-action="AddShowtime" method="post">
                                        <div class="form-group">
                                            <label>Phim</label>
                                            <input type="text" class="form-control" value="@selectedMovie.MovieName" readonly />
                                            <input type="hidden" asp-for="MovieId" value="@selectedMovie.MovieId" />
                                        </div>

                                        <div class="form-group">
                                            <label>Chi Nhánh</label>
                                            <input type="text" class="form-control" value="@selectedMovie.Branch?.BranchName" readonly />
                                            <input type="hidden" asp-for="Branch" value="@selectedMovie.Branch?.BranchName" />
                                        </div>

                                        <div class="form-group">
                                            <label asp-for="RoomId">Phòng</label>
                                            <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-control">
                                                <option value="">-- Chọn phòng --</option>
                                            </select>
                                            <span asp-validation-for="RoomId" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <label asp-for="ShowtimeDate">Lịch Chiếu</label>
                                            <input asp-for="ShowtimeDate" class="form-control" type="date" />
                                            <span asp-validation-for="ShowtimeDate" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <label asp-for="ScreenTimeId">Thời Gian Chiếu</label>
                                            <select asp-for="ScreenTimeId" asp-items="ViewBag.Screentimes" class="form-control">
                                                <option value="">-- Chọn giờ chiếu --</option>
                                            </select>
                                            <span asp-validation-for="ScreenTimeId" class="text-danger"></span>
                                        </div>

                                        @if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="alert alert-danger">
                                                @TempData["ErrorMessage"]
                                            </div>
                                        }

                                        <button type="submit" class="btn btn-primary">Thêm</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}