@model IEnumerable<WebCinema.Models.EmployeeModel>

@{
    ViewData["Title"] = "Employee List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
</div>

<style>
    .content-wrapper {
        margin-left: 250px;
        /* Khoảng cách từ sidebar */
        padding: 0px;
    }
</style>
<link rel="stylesheet" href="~/Admin/css/styles.min.css" />
<link rel="shortcut icon" type="image/png" href="~/Admin/images/logos/Logo.png" />
<div class="content-wrapper">
    <div class="container-fluid">
        <div class="mb-3" style="float: right;">
            <a href="@Url.Action("ExportToExcel", "Admin")" class="btn btn-primary">Xuất Excel</a>
        </div>
        <div style="clear: both;"></div>
        <h2 class="text-center">Danh Sách Nhân Viên</h2>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Mã Nhân Viên</th>
                    <th>Họ và Tên</th>
                    <th>Ngày Sinh</th>
                    <th>Giới Tính</th>
                    <th>Bộ Phận</th>
                    <th>Ca Làm Việc</th>
                    <th>Trạng Thái</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Lương</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@employee.EmployeeId</td>
                        <td>@employee.FullName</td>
                        <td>@employee.DateOfBirth.ToString("dd/MM/yyyy")</td> <!-- Cập nhật định dạng ngày sinh -->
                        <td>
                            @switch (employee.Gender)
                            {
                                case "male": <text>Nam</text>; break;
                                case "female": <text>Nữ</text>; break;
                                case "other": <text>Khác</text>; break;
                            }
                        </td>
                        <td>
                            @switch (employee.Position)
                            {
                                case "ticket_selling": <text>Bán vé</text>; break;
                                case "ticket_checking": <text>Soát vé</text>; break;
                                case "customer_support": <text>Hỗ trợ khách hàng</text>; break;
                                case "cleaning": <text>Vệ sinh</text>; break;
                            }
                        </td>
                        <td>
                            @switch (employee.Shift)
                            {
                                case "morning": <text>Sáng</text>; break;
                                case "afternoon": <text>Chiều</text>; break;
                                case "evening": <text>Tối</text>; break;
                            }
                        </td>
                        <td>
                            @switch (employee.Status)
                            {
                                case "full_time": <text>Toàn thời gian</text>; break;
                                case "part_time": <text>Bán thời gian</text>; break;
                            }
                        </td>
                        <td>@employee.Email</td>
                        <td>@employee.PhoneNumber</td>
                        <td>@employee.Salary.ToString("#,##0.00 VND")</td> <!-- Cập nhật định dạng lương -->
                        <td>
                            <a href="/Admin/Updateemployee/@employee.EmployeeId" class="btn btn-warning">Sửa</a>
                            <form action="/Admin/DeleteEmployee/@employee.EmployeeId" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa nhân viên này?');">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<script src="~/Admin/libs/jquery/dist/jquery.min.js"></script>
<script src="~/Admin/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Admin/js/sidebarmenu.js"></script>
<script src="~/Admin/js/app.min.js"></script>
