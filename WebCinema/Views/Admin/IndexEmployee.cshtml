    @model IEnumerable<WebCinema.Models.EmployeeModel>

@{
    ViewData["Title"] = "Employee List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title> - Admin</title>
    <link rel="stylesheet" href="~/Admin/css/styles.min.css" />
    <link rel="shortcut icon" type="image/png" href="~/Admin/images/logos/Logo.png" />
</head>

<body>
    <div class="container-fluid">
        <aside class="left-sidebar">
            <!-- Sidebar scroll-->
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    <a href="/" class="text-nowrap logo-img">
                        <img src="~/images/logo.png" width="180" alt="123" />
                    </a>
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-8"></i>
                    </div>
                </div>
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                            <span class="hide-menu">Statistic</span>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="~/Admin/DashBoard" aria-expanded="false">
                                <span>
                                    <i class="ti ti-layout-dashboard"></i>
                                </span>
                                <span class="hide-menu">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                            <span class="hide-menu">Movie</span>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="~/Admin/Add" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">Add Movie</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="~/Admin/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">Show all the movies</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="~/Admin/Addemployee" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">Employee</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="~/Admin/IndexEmployee" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">EmployeeList</span>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- End Sidebar navigation -->
            </div>
            <!-- End Sidebar scroll-->
        </aside>
        <div class="container-fluid">
            <div class="mb-3" style="float: right;">
                <a href="@Url.Action("ExportToExcel", "Admin")" class="btn btn-primary">Xuất Excel</a>
            </div>
            <div style="clear: both;"></div>
            <h2 class="text-center">Danh Sách Nhân Viên</h2>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Mã Nhân Viên</th>
                        <th>Họ và Tên</th>
                        <th>Ngày Sinh</th>
                        <th>Giới Tính</th>
                        <th>Bộ Phận</th>
                        <th>Ca Làm Việc</th>
                        <th>Trạng Thái</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Lương</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td>@employee.EmployeeId</td>
                            <td>@employee.FullName</td>
                            <td>@employee.DateOfBirth.ToString("dd/MM/yyyy")</td> <!-- Cập nhật định dạng ngày sinh -->
                            <td>@employee.Gender</td>
                            <td>@employee.Position</td>
                            <td>@employee.Shift</td>
                            <td>@employee.Status</td>
                            <td>@employee.Email</td>
                            <td>@employee.PhoneNumber</td>
                            <td>@employee.Salary.ToString("#,##0.00 VND")</td> <!-- Cập nhật định dạng lương -->
                            <td>
                                <a href="/Admin/AddEmployee/@employee.EmployeeId" class="btn btn-warning">Edit</a>
                                <form action="/Admin/DeleteEmployee/@employee.EmployeeId" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa nhân viên này?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <script src="~/Admin/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Admin/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Admin/js/sidebarmenu.js"></script>
    <script src="~/Admin/js/app.min.js"></script>
</body>
    </html>
